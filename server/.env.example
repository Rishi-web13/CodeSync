# ── Server ──
PORT=4000
# Browser origin(s) allowed to call the API / open WebSockets (comma-separated)
WEB_ORIGIN=http://localhost:5173

# ── Supabase (server-side only! never expose the service role key) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Code execution (Docker) ──
# Set to "false" to disable execution entirely
EXEC_ENABLED=true
EXEC_TIMEOUT_MS=10000
EXEC_MEMORY_MB=256
EXEC_CPUS=0.5
EXEC_PIDS_LIMIT=128
EXEC_MAX_OUTPUT_BYTES=65536

# ── AI help assistant (optional) ──
# Groq has a free tier: create a key at console.groq.com/keys (it starts with gsk_).
# xAI Grok keys (xai-...) also work. The provider is detected from the key.
GROQ_API_KEY=
# Optional: change the model (see console.groq.com/docs/models). A fallback model is used automatically when the main one is busy.
# AI_MODEL=llama-3.3-70b-versatile
# AI_FALLBACK_MODEL=llama-3.1-8b-instant
